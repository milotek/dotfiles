alias larp="fastfetch"
alias larpmaxx="btop"
alias ct="ssh milotek.c.googlers.com"
alias rw="rw milotek.c.googlers.com"
alias ws="jj jjd"
alias gemini='/google/bin/releases/gemini-cli/tools/gemini'
alias swir="rm -rf /Users/milotek/Work/swi && mkdir -p /Users/milotek/Work/swi && scp milotek@milotek.c.googlers.com:/google/src/cloud/milotek/swi/google3/blaze-out/k8-opt/genfiles/search/xga/xplatform/tools/search_dev_toolkit/chrome_extension_dev.zip /Users/milotek/Work/swi && unzip -o /Users/milotek/Work/swi/chrome_extension_dev.zip -d /Users/milotek/Work/swi && rm /Users/milotek/Work/swi/chrome_extension_dev.zip && open -g -a 'Google Chrome' 'http://reload.extensions'"
